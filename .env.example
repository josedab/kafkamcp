# KafkaMCP Environment Variables
# Copy this file to .env and fill in your values.
# These variables are referenced in example config files (see examples/).

# --- Runtime Overrides ---
# KAFKAMCP_TRANSPORT=stdio        # stdio | sse | streamable-http
# KAFKAMCP_LOG_LEVEL=info         # debug | info | warn | error

# --- Confluent Cloud (examples/confluent-cloud.yaml) ---
CONFLUENT_BOOTSTRAP_SERVERS=pkc-xxxxx.us-east-1.aws.confluent.cloud:9092
CONFLUENT_API_KEY=your-api-key
CONFLUENT_API_SECRET=your-api-secret
CONFLUENT_SR_URL=https://psrc-xxxxx.us-east-1.aws.confluent.cloud
CONFLUENT_SR_API_KEY=your-sr-api-key
CONFLUENT_SR_API_SECRET=your-sr-api-secret

# --- Default config (kafkamcp.yaml) ---
SR_USERNAME=your-sr-username
SR_PASSWORD=your-sr-password

# --- Multi-cluster (examples/multi-cluster.yaml) ---
PROD_KAFKA_USERNAME=your-prod-username
PROD_KAFKA_PASSWORD=your-prod-password
PROD_SR_USERNAME=your-prod-sr-username
PROD_SR_PASSWORD=your-prod-sr-password

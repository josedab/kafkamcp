{
  "$note": "Stable config-schema contract. Any change to this file means a breaking or additive schema change. Run: go test ./internal/config/ -run TestSchemaContract -update",
  "$schema_version": "1",
  "$source": "docs/kafkamcp.schema.json",
  "schema": {
    "properties": {
      "audit": {
        "properties": {
          "enabled": {
            "default": false,
            "type": "boolean",
            "x-stability": "stable"
          },
          "log_file": {
            "type": "string",
            "x-stability": "stable"
          },
          "max_entries": {
            "default": 10000,
            "minimum": 1,
            "type": "integer"
          }
        },
        "type": "object"
      },
      "clusters": {
        "items": {
          "properties": {
            "bootstrap_servers": {
              "type": "string",
              "x-stability": "stable"
            },
            "connect_tls": {
              "properties": {
                "ca_file": {
                  "type": "string"
                },
                "insecure_skip_verify": {
                  "default": false,
                  "type": "boolean"
                },
                "min_version": {
                  "enum": [
                    "1.2",
                    "1.3"
                  ],
                  "type": "string"
                }
              },
              "type": "object"
            },
            "connect_url": {
              "type": "string"
            },
            "default": {
              "default": false,
              "type": "boolean",
              "x-stability": "stable"
            },
            "name": {
              "type": "string",
              "x-stability": "stable"
            },
            "sasl_mechanism": {
              "enum": [
                "PLAIN",
                "SCRAM-SHA-256",
                "SCRAM-SHA-512"
              ],
              "type": "string",
              "x-stability": "stable"
            },
            "sasl_password": {
              "type": "string",
              "x-stability": "stable"
            },
            "sasl_username": {
              "type": "string",
              "x-stability": "stable"
            },
            "schema_registry": {
              "properties": {
                "auth": {
                  "properties": {
                    "password": {
                      "type": "string"
                    },
                    "username": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "url": {
                  "type": "string",
                  "x-stability": "stable"
                }
              },
              "type": "object"
            },
            "security_protocol": {
              "default": "PLAINTEXT",
              "enum": [
                "PLAINTEXT",
                "SASL_PLAINTEXT",
                "SASL_SSL",
                "SSL"
              ],
              "type": "string",
              "x-stability": "stable"
            },
            "ssl_ca_location": {
              "type": "string",
              "x-stability": "stable"
            },
            "tls_min_version": {
              "default": "1.2",
              "enum": [
                "1.2",
                "1.3"
              ],
              "type": "string"
            }
          },
          "required": [
            "bootstrap_servers",
            "name"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "masking": {
        "properties": {
          "enabled": {
            "default": false,
            "type": "boolean"
          },
          "key_env": {
            "default": "KAFKAMCP_MASKING_KEY",
            "type": "string"
          },
          "rules": {
            "items": {
              "properties": {
                "agents": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "field_path": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "pattern": {
                  "type": "string"
                },
                "replace": {
                  "default": "***REDACTED***",
                  "type": "string"
                },
                "type": {
                  "enum": [
                    "credit_card",
                    "email",
                    "ner",
                    "phone",
                    "regex",
                    "ssn"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "name",
                "type"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "policies": {
        "properties": {
          "agents": {
            "items": {
              "properties": {
                "consumer_groups": {
                  "properties": {
                    "permissions": {
                      "items": {
                        "enum": [
                          "describe",
                          "reset"
                        ],
                        "type": "string"
                      },
                      "type": "array"
                    }
                  },
                  "type": "object"
                },
                "id": {
                  "type": "string"
                },
                "rate_limit": {
                  "properties": {
                    "requests_per_minute": {
                      "minimum": 1,
                      "type": "integer"
                    }
                  },
                  "type": "object"
                },
                "role": {
                  "enum": [
                    "admin",
                    "reader",
                    "writer"
                  ],
                  "type": "string"
                },
                "schemas": {
                  "properties": {
                    "permissions": {
                      "items": {
                        "enum": [
                          "read",
                          "write"
                        ],
                        "type": "string"
                      },
                      "type": "array"
                    }
                  },
                  "type": "object"
                },
                "topics": {
                  "items": {
                    "properties": {
                      "pattern": {
                        "type": "string"
                      },
                      "permissions": {
                        "items": {
                          "enum": [
                            "admin",
                            "create",
                            "delete",
                            "read",
                            "write"
                          ],
                          "type": "string"
                        },
                        "type": "array"
                      }
                    },
                    "type": "object"
                  },
                  "type": "array"
                }
              },
              "required": [
                "id"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "approval": {
            "properties": {
              "allow_self_approval": {
                "default": false,
                "type": "boolean"
              },
              "enabled": {
                "type": "boolean"
              },
              "max_ttl_seconds": {
                "default": 3600,
                "type": "integer"
              },
              "previous_signing_key_envs": {
                "default": [],
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "signing_key_env": {
                "default": "KAFKAMCP_APPROVAL_SIGNING_KEY",
                "type": "string"
              },
              "single_use": {
                "default": true,
                "type": "boolean"
              },
              "terminal_retention_seconds": {
                "default": 604800,
                "maximum": 2592000,
                "minimum": 0,
                "type": "integer"
              },
              "ttl_seconds": {
                "default": 300,
                "type": "integer"
              }
            },
            "type": "object"
          },
          "default_deny": {
            "default": false,
            "type": "boolean",
            "x-stability": "stable"
          },
          "identity": {
            "properties": {
              "allow_header_fallback": {
                "type": "boolean"
              },
              "mtls": {
                "properties": {
                  "allow_cn_fallback": {
                    "default": true,
                    "type": "boolean"
                  },
                  "allowed_spiffe_ids": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "allowed_trust_domains": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "ca_bundle": {
                    "type": "string"
                  },
                  "groups_from_ous": {
                    "default": false,
                    "type": "boolean"
                  }
                },
                "type": "object"
              },
              "oidc": {
                "properties": {
                  "agent_id_claim": {
                    "default": "sub",
                    "type": "string"
                  },
                  "client_id": {
                    "type": "string"
                  },
                  "email_claim": {
                    "default": "email",
                    "type": "string"
                  },
                  "groups_claim": {
                    "default": "groups",
                    "type": "string"
                  },
                  "issuer_url": {
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "provider": {
                "default": "none",
                "enum": [
                  "mtls",
                  "none",
                  "oidc",
                  "static"
                ],
                "type": "string"
              },
              "static": {
                "properties": {
                  "tokens": {
                    "items": {
                      "properties": {
                        "agent_id": {
                          "type": "string"
                        },
                        "groups": {
                          "items": {
                            "type": "string"
                          },
                          "type": "array"
                        },
                        "token": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "agent_id",
                        "token"
                      ],
                      "type": "object"
                    },
                    "type": "array"
                  }
                },
                "type": "object"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "schema_cache": {
        "properties": {
          "max_entries": {
            "default": 10000,
            "minimum": 1,
            "type": "integer"
          },
          "ttl_seconds": {
            "default": 300,
            "minimum": 1,
            "type": "integer"
          }
        },
        "type": "object"
      },
      "server": {
        "properties": {
          "dangerously_allow_unauthenticated_network": {
            "default": false,
            "type": "boolean"
          },
          "host": {
            "default": "0.0.0.0",
            "type": "string",
            "x-stability": "stable"
          },
          "log_level": {
            "default": "info",
            "enum": [
              "debug",
              "error",
              "info",
              "warn"
            ],
            "type": "string",
            "x-stability": "stable"
          },
          "max_message_size": {
            "default": 1048576,
            "minimum": 1,
            "type": "integer"
          },
          "metrics_host": {
            "default": "127.0.0.1",
            "type": "string"
          },
          "metrics_port": {
            "default": 3101,
            "maximum": 65535,
            "minimum": 1,
            "type": "integer"
          },
          "persistence": {
            "properties": {
              "backend": {
                "default": "inmem",
                "enum": [
                  "inmem",
                  "sqlite"
                ],
                "type": "string"
              },
              "path": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "port": {
            "default": 3100,
            "maximum": 65535,
            "minimum": 1,
            "type": "integer",
            "x-stability": "stable"
          },
          "tls_cert": {
            "type": "string"
          },
          "tls_key": {
            "type": "string"
          },
          "tool_packs": {
            "default": [
              "core-read"
            ],
            "items": {
              "enum": [
                "core-read",
                "essential",
                "governance",
                "ops",
                "ops-write"
              ],
              "type": "string"
            },
            "type": "array"
          },
          "transport": {
            "default": "stdio",
            "enum": [
              "sse",
              "stdio",
              "streamable-http"
            ],
            "type": "string",
            "x-stability": "stable"
          }
        },
        "type": "object"
      },
      "telemetry": {
        "properties": {
          "activation_metrics": {
            "default": false,
            "type": "boolean"
          },
          "enabled": {
            "default": false,
            "type": "boolean"
          },
          "endpoint": {
            "type": "string"
          },
          "insecure": {
            "default": false,
            "type": "boolean"
          },
          "sample_rate": {
            "default": 1,
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "service_name": {
            "default": "kafkamcp",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "required": [
      "clusters"
    ],
    "type": "object"
  }
}
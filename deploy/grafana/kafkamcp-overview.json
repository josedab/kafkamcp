{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "9.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    }
  ],
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Overview",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 500 }
            ]
          },
          "mappings": []
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Tool Calls (Rate/min)",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(kafkamcp_tool_calls_total[5m])) * 60",
          "legendFormat": ""
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "mappings": []
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Active Connections",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(kafkamcp_active_connections)",
          "legendFormat": ""
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 10 }
            ]
          },
          "mappings": []
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "id": 3,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Errors (Rate/min)",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(kafkamcp_tool_calls_total{status=\"error\"}[5m])) * 60",
          "legendFormat": ""
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          },
          "mappings": []
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "id": 4,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Avg Tool Latency (p50)",
      "type": "stat",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(kafkamcp_tool_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": ""
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "Tool Performance",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" } }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 5,
      "title": "Tool Call Rate by Tool",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (tool) (rate(kafkamcp_tool_calls_total[5m]))",
          "legendFormat": "{{ tool }}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" } }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 6,
      "title": "Tool Latency (p95) by Tool",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (tool, le) (rate(kafkamcp_tool_latency_seconds_bucket[5m])))",
          "legendFormat": "{{ tool }}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" } }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "id": 7,
      "title": "Tool Errors by Tool",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (tool) (rate(kafkamcp_tool_calls_total{status=\"error\"}[5m]))",
          "legendFormat": "{{ tool }}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "custom": { "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" } }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "id": 8,
      "title": "Tool Error Rate by Tool",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (tool) (rate(kafkamcp_tool_calls_total{status=\"error\"}[5m])) / sum by (tool) (rate(kafkamcp_tool_calls_total[5m]))",
          "legendFormat": "{{ tool }}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "id": 102,
      "title": "Kafka Messages",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" } }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "id": 9,
      "title": "Messages Consumed (Rate) by Topic",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (topic) (rate(kafkamcp_messages_consumed_total[5m]))",
          "legendFormat": "{{ topic }}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" } }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "id": 10,
      "title": "Messages Produced (Rate) by Topic",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (topic) (rate(kafkamcp_messages_produced_total[5m]))",
          "legendFormat": "{{ topic }}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 },
      "id": 103,
      "title": "Schema Registry",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" } }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "id": 11,
      "title": "Schema Cache Hit/Miss Rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(kafkamcp_schema_cache_hits_total[5m]))",
          "legendFormat": "hits"
        },
        {
          "expr": "sum(rate(kafkamcp_schema_cache_misses_total[5m]))",
          "legendFormat": "misses"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "custom": { "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" } }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "id": 12,
      "title": "Schema Cache Hit Rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(kafkamcp_schema_cache_hits_total[5m])) / (sum(rate(kafkamcp_schema_cache_hits_total[5m])) + sum(rate(kafkamcp_schema_cache_misses_total[5m])))",
          "legendFormat": "hit rate"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 40 },
      "id": 104,
      "title": "Security & Rate Limiting",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" } }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 41 },
      "id": 13,
      "title": "Kafka Connection Errors",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (cluster, error_type) (rate(kafkamcp_kafka_connection_errors_total[5m]))",
          "legendFormat": "{{ cluster }} - {{ error_type }}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" } }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 41 },
      "id": 14,
      "title": "Authorization Denials",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (reason) (rate(kafkamcp_authz_denials_total[5m]))",
          "legendFormat": "{{ reason }}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" } }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 41 },
      "id": 15,
      "title": "Rate Limit Denials",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (tool) (rate(kafkamcp_rate_limit_denials_total[5m]))",
          "legendFormat": "{{ tool }}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 49 },
      "id": 105,
      "title": "Connections",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 1, "fillOpacity": 20, "showPoints": "never" } }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 50 },
      "id": 16,
      "title": "Active Connections by Transport",
      "type": "timeseries",
      "targets": [
        {
          "expr": "kafkamcp_active_connections",
          "legendFormat": "{{ transport }}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" } }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 50 },
      "id": 17,
      "title": "Tool Call Rate by Agent",
      "type": "timeseries",
      "targets": [
        {
          "expr": "topk(10, sum by (agent_id) (rate(kafkamcp_tool_calls_total[5m])))",
          "legendFormat": "{{ agent_id }}"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 36,
  "style": "dark",
  "tags": ["kafkamcp", "kafka", "mcp"],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "KafkaMCP Overview",
  "uid": "kafkamcp-overview",
  "version": 1
}

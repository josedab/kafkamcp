<idea-plugin>
    <id>io.kafkamcp.plugin</id>
    <name>KafkaMCP</name>
    <version>0.1.0</version>
    <vendor email="support@kafkamcp.io" url="https://kafkamcp.io">KafkaMCP</vendor>

    <description><![CDATA[
    KafkaMCP IDE integration for IntelliJ IDEA.
    <ul>
      <li>Topic Browser: Browse and inspect Kafka topics in a tree view</li>
      <li>Schema-Aware Editing: Autocomplete fields from Avro/Protobuf/JSON schemas</li>
      <li>Message Inspector: Preview messages inline without leaving your IDE</li>
      <li>Consumer Group Monitoring: View lag and group status</li>
      <li>MCP Tool Integration: Execute KafkaMCP tools directly from the IDE</li>
    </ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="KafkaMCP" secondary="true" anchor="right"
                    factoryClass="io.kafkamcp.plugin.KafkaMCPToolWindowFactory"
                    icon="/icons/kafkamcp.svg"/>
        <applicationService serviceImplementation="io.kafkamcp.plugin.KafkaMCPSettings"/>
        <notificationGroup id="KafkaMCP" displayType="BALLOON"/>
        <completion.contributor language="JSON"
                               implementationClass="io.kafkamcp.plugin.SchemaCompletionContributor"/>
    </extensions>

    <actions>
        <group id="KafkaMCP.Actions" text="KafkaMCP" description="KafkaMCP actions">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <action id="KafkaMCP.BrowseTopics" class="io.kafkamcp.plugin.BrowseTopicsAction"
                    text="Browse Topics" description="Open Kafka topic browser"/>
            <action id="KafkaMCP.PreviewMessage" class="io.kafkamcp.plugin.PreviewMessageAction"
                    text="Preview Messages" description="Preview topic messages"/>
            <action id="KafkaMCP.RefreshConnection" class="io.kafkamcp.plugin.RefreshConnectionAction"
                    text="Refresh Connection" description="Reconnect to KafkaMCP server"/>
        </group>
    </actions>
</idea-plugin>

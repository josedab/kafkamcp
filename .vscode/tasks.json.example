{
  // Copy this file to tasks.json to use these tasks from the VS Code command palette.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build",
      "type": "shell",
      "command": "make build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$go"]
    },
    {
      "label": "Test",
      "type": "shell",
      "command": "make test",
      "group": "test",
      "problemMatcher": ["$go"]
    },
    {
      "label": "Test (short)",
      "type": "shell",
      "command": "make test-short",
      "group": "test",
      "problemMatcher": ["$go"]
    },
    {
      "label": "Lint",
      "type": "shell",
      "command": "make lint",
      "problemMatcher": ["$go"]
    },
    {
      "label": "Format",
      "type": "shell",
      "command": "make fmt",
      "problemMatcher": []
    },
    {
      "label": "Validate (all checks)",
      "type": "shell",
      "command": "make validate",
      "group": "test",
      "problemMatcher": ["$go"]
    },
    {
      "label": "Vet",
      "type": "shell",
      "command": "make vet",
      "problemMatcher": ["$go"]
    },
    {
      "label": "Dev (hot-reload)",
      "type": "shell",
      "command": "make dev",
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}

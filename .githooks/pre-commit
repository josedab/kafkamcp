#!/bin/sh
# Pre-commit hook: runs formatting check, static analysis, and linting.
# Installed via: make setup-hooks

set -e

echo "Running pre-commit checks..."
if ! (make fmt-check && make vet && make lint); then
	echo ""
	echo "Hint: try 'make clean && make validate' if failures seem stale."
	exit 1
fi
echo "Pre-commit checks passed."
